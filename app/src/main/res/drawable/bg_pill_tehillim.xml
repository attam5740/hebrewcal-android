<?xml version="1.0" encoding="utf-8"?>
<!-- Glass pill with a soft apricot glow halo (static — notifications can't animate) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#33FFB86C" />
            <corners android:radius="19dp" />
        </shape>
    </item>
    <item android:top="3dp" android:bottom="3dp" android:left="3dp" android:right="3dp">
        <shape android:shape="rectangle">
            <gradient android:startColor="#5CFFC98A" android:endColor="#2EFFB86C" android:angle="270" />
            <stroke android:width="1dp" android:color="#E6FFB86C" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</layer-list>
