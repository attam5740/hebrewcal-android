<?xml version="1.0" encoding="utf-8"?>
<!-- Glass pill with a soft wine-red glow halo, for the Motzei Shabbat Havdalah button -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#33D9738F" />
            <corners android:radius="19dp" />
        </shape>
    </item>
    <item android:top="3dp" android:bottom="3dp" android:left="3dp" android:right="3dp">
        <shape android:shape="rectangle">
            <gradient android:startColor="#5CB0506C" android:endColor="#2E8E3651" android:angle="270" />
            <stroke android:width="1dp" android:color="#E6D9738F" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</layer-list>
