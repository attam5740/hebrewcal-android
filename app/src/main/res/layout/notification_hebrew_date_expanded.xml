<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="8dp"
    android:gravity="start">

    <!-- Hebrew date — large -->
    <TextView
        android:id="@+id/tv_hebrew_date_exp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#E8D5B7"
        android:fontFamily="serif"
        android:text="כ״ב ניסן תשפ״ו" />

    <!-- Gregorian date -->
    <TextView
        android:id="@+id/tv_gregorian_exp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:textColor="#AA9977"
        android:text="April 22, 2026"
        android:layout_marginTop="2dp" />

    <!-- Holiday -->
    <TextView
        android:id="@+id/tv_holiday_exp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#D4AF37"
        android:layout_marginTop="2dp"
        android:text="" />

    <!-- Parsha -->
    <TextView
        android:id="@+id/tv_parsha_exp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:textColor="#B8A888"
        android:layout_marginTop="1dp"
        android:text=""
        android:visibility="gone" />

    <!-- Omer count -->
    <TextView
        android:id="@+id/tv_omer_exp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:textColor="#7EC8E3"
        android:layout_marginTop="1dp"
        android:text=""
        android:visibility="gone" />

    <!-- Divider — plain View is not in RemoteViews whitelist; use TextView instead -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#33FFFFFF"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="6dp" />

    <!-- Reader buttons — bright in-layout pills (system action buttons are
         OEM-styled and ignore accent colors, so we draw our own) -->
    <LinearLayout
        android:id="@+id/ll_reader_buttons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="6dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_btn_tehillim"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_tehillim"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#1A1A2E"
            android:text=""
            android:visibility="gone" />

        <TextView
            android:id="@+id/tv_btn_parsha"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_pill_parsha"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#1A1A2E"
            android:text=""
            android:visibility="gone" />
    </LinearLayout>

    <!-- Zmanim container — rows added dynamically -->
    <LinearLayout
        android:id="@+id/ll_zmanim_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone" />

</LinearLayout>
