<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="4dp"
    android:gravity="start">

    <!-- Hebrew date — primary large text -->
    <TextView
        android:id="@+id/tv_hebrew_date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#E8D5B7"
        android:fontFamily="serif"
        android:text="כ״ב ניסן תשפ״ו"
        android:gravity="start" />

    <!-- Gregorian date -->
    <TextView
        android:id="@+id/tv_gregorian"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:textColor="#AA9977"
        android:text="April 22, 2026"
        android:layout_marginTop="1dp" />

    <!-- Holiday label -->
    <TextView
        android:id="@+id/tv_holiday"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="#D4AF37"
        android:text=""
        android:layout_marginTop="2dp" />

    <!-- Reader buttons — compact pills, visible without expanding -->
    <LinearLayout
        android:id="@+id/ll_reader_buttons_c"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="4dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_btn_tehillim_c"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_tehillim"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#1A1A2E"
            android:text=""
            android:visibility="gone" />

        <TextView
            android:id="@+id/tv_btn_parsha_c"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_pill_parsha"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#1A1A2E"
            android:text=""
            android:visibility="gone" />
    </LinearLayout>

    <!-- Next zman (collapsed) -->
    <TextView
        android:id="@+id/tv_next_zman"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:textColor="#7EC8E3"
        android:text=""
        android:layout_marginTop="3dp"
        android:visibility="gone" />

</LinearLayout>
