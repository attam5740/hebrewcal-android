<?xml version="1.0" encoding="utf-8"?>
<!--
  Simplified Star of David (Magen David) as a notification icon.
  Two overlapping triangles forming the hexagram.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- Upper triangle (pointing up) -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M12,2 L21.5,18 L2.5,18 Z" />

    <!-- Lower triangle (pointing down) -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M12,22 L2.5,6 L21.5,6 Z" />

    <!-- Center white hexagon to create the Star of David hollow effect -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#121218"
        android:strokeWidth="1.5"
        android:pathData="M12,2 L21.5,18 L2.5,18 Z" />
    <path
        android:fillColor="#00000000"
        android:strokeColor="#121218"
        android:strokeWidth="1.5"
        android:pathData="M12,22 L2.5,6 L21.5,6 Z" />

</vector>
